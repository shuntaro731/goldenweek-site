---
import title from "../assets/title/type=title1.svg";

interface Props {
  color?: string;
  class?: string;
}

const { color, class: className } = Astro.props;
const style = [
  `--title-url: url("${title.src}")`,
  `--title-ratio: ${title.width} / ${title.height}`,
  color ? `color: ${color}` : "",
]
  .filter(Boolean)
  .join("; ");
---

<span
  class:list={["title-svg", className]}
  role="img"
  aria-label="青森県立美術館"
  style={style}
>
</span>

<style>
  .title-svg {
    display: block;
    aspect-ratio: var(--title-ratio);
    background-color: currentColor;
    mask: var(--title-url) center / contain no-repeat;
    -webkit-mask: var(--title-url) center / contain no-repeat;
  }
</style>
