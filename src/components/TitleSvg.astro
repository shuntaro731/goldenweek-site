---
import title1 from "../assets/title/type=title1.svg";
import title2 from "../assets/title/type=title2.svg";
import title3 from "../assets/title/type=title3.svg";

type TitleType = "title1" | "title2" | "title3";

interface Props {
  type?: TitleType;
  label?: string;
  color?: string;
  class?: string;
}

const titles = {
  title1,
  title2,
  title3,
};

const {
  type = "title1",
  label = "青森県立美術館",
  color,
  class: className,
} = Astro.props;

const title = titles[type];
const style = [
  `--title-url: url("${title.src}")`,
  `--title-ratio: ${title.width} / ${title.height}`,
  color ? `color: ${color}` : "",
]
  .filter(Boolean)
  .join("; ");
---

<span
  class:list={["title-svg", className]}
  role="img"
  aria-label={label}
  style={style}
>
</span>

<style>
  .title-svg {
    display: block;
    aspect-ratio: var(--title-ratio);
    background-color: currentColor;
    mask: var(--title-url) center / contain no-repeat;
    -webkit-mask: var(--title-url) center / contain no-repeat;
  }
</style>
