---
import ImageViewer from "../ImageViewer.astro";
import { museums } from "../../data/museums";

const museumImages = museums.map((museum) => ({
  src: museum.image.src,
  alt: museum.name,
}));
---

<section class="flex h-full shrink-0 bg-[#f3f2e8] pl-16" aria-label="polite">
  <div id="hero-museum" class="relative flex-1 overflow-hidden bg-[#1a1a18]">
    <ImageViewer images={museumImages} interval={4000} />
    <!-- 空のdiv要素でラップ -->
    <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>

    <div
      class="absolute inset-x-18 bottom-16 flex items-end justify-between gap-24"
    >
      <div
        class="hero-blur-fade flex items-center gap-4 text-lg font-light text-white"
        style="--blur-fade-delay: 160ms;"
      >
        <span data-hero-current>01</span>
        <span class="w-10 border-t border-white" aria-hidden="true"></span>
        <span data-hero-total>{String(museums.length).padStart(2, "0")}</span>
      </div>

      <section class="w-110 text-right">
        <span
          class="hero-title hero-blur-fade ml-auto block w-full text-white"
          role="img"
          aria-label={museums[0].name}
          style={`--title-url: url("${museums[0].titleSvg.src}");`}
          data-hero-title></span>
        <p
          class="hero-blur-fade mt-4 text-base tracking-wide text-white/90 font-extralight"
          style="--blur-fade-delay: 40ms;"
          data-hero-english-name
        >
          {museums[0].englishName}
        </p>
        <div
          class="hero-blur-fade mt-7 border-t border-white/70"
          style="--blur-fade-delay: 80ms;"
        >
        </div>
        <p
          class="hero-blur-fade mt-6 text-sm leading-7 font-medium text-white"
          style="--blur-fade-delay: 120ms;"
          data-hero-copy
        >
          {museums[0].description}<br />
        </p>
      </section>
    </div>
  </div>
</section>

<script define:vars={{ museums }}>
  const hero = document.querySelector("#hero-museum");
  const title = document.querySelector("[data-hero-title]");
  const current = document.querySelector("[data-hero-current]");
  const englishName = document.querySelector("[data-hero-english-name]");
  const copy = document.querySelector("[data-hero-copy]");
  const blurFadeItems = [...document.querySelectorAll(".hero-blur-fade")];
  let contentTimer;

  const setActive = (nextIndex) => {
    const museum = museums[nextIndex];

    if (title) {
      title.style.setProperty("--title-url", `url("${museum.titleSvg.src}")`);
      title.setAttribute("aria-label", museum.name);
    }
    if (current) current.textContent = String(nextIndex + 1).padStart(2, "0");
    if (englishName) englishName.textContent = museum.englishName;
    if (copy) copy.textContent = museum.description;
  };

  hero?.addEventListener("imageviewer:change", (event) => {
    window.clearTimeout(contentTimer);
    blurFadeItems.forEach((item) => {
      item.classList.add("is-blur-hidden");
    });

    contentTimer = window.setTimeout(() => {
      setActive(event.detail.index);

      window.requestAnimationFrame(() => {
        blurFadeItems.forEach((item) => {
          item.classList.remove("is-blur-hidden");
        });
      });
    }, 320);
  });
</script>

<style>
  /* ブラーアニメーション */
  .hero-blur-fade {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
    transition:
      opacity 600ms ease-out var(--blur-fade-delay, 0ms),
      filter 600ms ease-out var(--blur-fade-delay, 0ms),
      transform 600ms ease-out var(--blur-fade-delay, 0ms);
    will-change: opacity, filter, transform;
  }

  .hero-blur-fade.is-blur-hidden {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(-6px);
    transition-delay: 0ms;
  }

  .hero-title {
    height: 47px;
    background-color: currentColor;
    mask-image: var(--title-url);
    mask-position: right center;
    mask-repeat: no-repeat;
    mask-size: contain;
    -webkit-mask-image: var(--title-url);
    -webkit-mask-position: right center;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: contain;
  }
</style>
