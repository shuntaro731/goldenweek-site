---
import ContentArticle from "../ContentArticle.astro";
import type { Museum } from "../../data/museums";
import { museums } from "../../data/museums";

interface Props {
  items?: Museum[];
}

const { items = museums } = Astro.props;
---

<section
  id="contents"
  class="bg-[#F0F0E4] py-42 text-[#1a1a18]"
  aria-labelledby="contents-title"
>
  <div class="mx-auto w-full max-w-screen-2xl">
    <header
      class="mx-6 mt-36 mb-36 flex items-start justify-between gap-8 md:mx-28"
    >
      <div class="flex min-w-0 flex-col gap-6 md:flex-row md:items-baseline">
        <h2
          id="contents-title"
          class="text-5xl leading-none font-medium uppercase"
        >
          Museum List
        </h2>
        <p class="shrink-0 text-lg font-medium">
          (行きたい美術館)
        </p>
      </div>
      <p
        class="hidden text-right text-base font-light text-neutral-400 sm:block"
      >
        HAL<br />
        Goldenweek for<br />
        April 28 ~ May 6
      </p>
    </header>
    <div class="mx-6 grid gap-36 md:mx-28">
      <!-- 美術館の記事要素 -->
      {
        items.map((item, index) => (
          <ContentArticle item={item} index={index} total={items.length} />
        ))
      }
    </div>
  </div>
</section>
