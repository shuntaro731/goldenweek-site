---
import ContentArticle from "../ContentArticle.astro";
import { Highlighter } from "../ui/highlighter";
import type { Museum } from "../../data/museums";
import { museums } from "../../data/museums";

interface Props {
  items?: Museum[];
}

const { items = museums } = Astro.props;
---

<section
  class="bg-[#F0F0E4] py-[clamp(72px,9vw,144px)] pb-[clamp(80px,10vw,160px)] text-[#1a1a18]"
  aria-labelledby="contents-title"
>
  <div class="mx-auto w-[min(100%,1440px)]">
    <header
      class="mx-[clamp(24px,7vw,112px)] mb-[clamp(56px,6vw,96px)] flex items-start justify-between gap-8 pt-[clamp(16px,2vw,32px)]"
    >
      <div class="flex min-w-0 items-baseline gap-[clamp(12px,1.6vw,24px)]">
        <h2
          id="contents-title"
          class="text-[clamp(2rem,5vw,3rem)] leading-none font-medium uppercase"
        >
          Museum List
        </h2>
        <p class="shrink-0 text-[clamp(0.875rem,1.1vw,1.125rem)] font-medium">
          <Highlighter
            client:load
            action="highlight"
            color="#87CEFA"
            strokeWidth={1.5}
            animationDuration={650}
            iterations={2}
            padding={2}
          >
            美術館リスト
          </Highlighter>
        </p>
      </div>
      <p
        class="hidden text-right text-[clamp(0.875rem,1vw,1rem)] font-light text-neutral-400 sm:block"
      >
        HAL<br />
        Goldenweek for<br />
        April 28 ~ May 6
      </p>
    </header>
    <div class="mx-[clamp(24px,7vw,112px)] grid gap-[clamp(72px,9vw,144px)]">
      <!-- 美術館の記事要素 -->
      {
        items.map((item, index) => (
          <ContentArticle item={item} index={index} total={items.length} />
        ))
      }
    </div>
  </div>
</section>
