---
import ContentArticle from "../ContentArticle.astro";
import { Highlighter } from "../ui/highlighter";
import type { Museum } from "../../data/museums";
import { museums } from "../../data/museums";

interface Props {
  items?: Museum[];
}

const { items = museums } = Astro.props;
---

<section
  id="contents"
  class="bg-[#F0F0E4] py-20 pb-24 text-[#1a1a18] md:py-36 md:pb-40"
  aria-labelledby="contents-title"
>
  <div class="mx-auto w-full max-w-screen-2xl">
    <header
      class="mx-6 mb-14 flex items-start justify-between gap-8 pt-4 md:mx-28 md:mb-24 md:pt-8"
    >
      <div class="flex min-w-0 flex-col gap-4 md:flex-row md:items-baseline md:gap-12">
        <h2
          id="contents-title"
          class="text-4xl leading-none font-medium uppercase md:text-5xl"
        >
          Museum List
        </h2>
        <p class="shrink-0 text-sm font-medium md:text-lg">
          ( GWに行きたい美術館 )
        </p>
      </div>
      <p
        class="hidden text-right text-sm font-light text-neutral-400 sm:block md:text-base"
      >
        HAL<br />
        Goldenweek for<br />
        April 28 ~ May 6
      </p>
    </header>
    <div class="mx-6 grid gap-20 md:mx-28 md:gap-36">
      <!-- 美術館の記事要素 -->
      {
        items.map((item, index) => (
          <ContentArticle item={item} index={index} total={items.length} />
        ))
      }
    </div>
  </div>
</section>
