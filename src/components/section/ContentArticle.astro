---
import type { Museum } from "../../data/museums";

interface Props {
  item: Museum;
  index: number;
  total: number;
}

const { item, index, total } = Astro.props;
const number = String(index + 1).padStart(2, "0");
const totalCount = String(total).padStart(2, "0");

const galleryLayouts = {
  split: {
    wrap: "md:grid-cols-12 md:items-start",
    items: [
      "md:col-span-5 md:col-start-2",
      "md:col-span-5 md:col-start-7 md:mt-24",
      "md:col-span-4 md:col-start-1 md:mt-8",
      "md:col-span-4 md:col-start-6 md:mt-20",
      "md:col-span-3 md:col-start-10 md:mt-2",
    ],
  },
  staggered: {
    wrap: "md:grid-cols-12 md:items-start",
    items: [
      "md:col-span-7 md:col-start-1",
      "md:col-span-4 md:col-start-9 md:mt-32",
      "md:col-span-5 md:col-start-3 md:mt-14",
      "md:col-span-4 md:col-start-8 md:mt-4",
      "md:col-span-6 md:col-start-1 md:mt-24",
    ],
  },
  mosaic: {
    wrap: "md:grid-cols-12 md:items-end",
    items: [
      "md:col-span-8 md:col-start-3",
      "md:col-span-3 md:col-start-1 md:mt-18",
      "md:col-span-4 md:col-start-5 md:mt-28",
      "md:col-span-3 md:col-start-10 md:mt-12",
      "md:col-span-7 md:col-start-4 md:mt-20",
    ],
  },
};

const gallery = galleryLayouts[item.galleryLayout];
---

<article
  class="min-w-0"
  aria-labelledby={`content-title-${index}`}
>
  <header class="min-w-0">
    <p class="mb-5 flex items-baseline gap-1.5 font-bold tracking-[0.02em]">
      <span class="text-[clamp(1rem,1.7vw,1.5rem)]">#</span>
      <span class="text-[clamp(2rem,4vw,4rem)] leading-none">{number}</span>
      <span class="text-[clamp(1rem,1.7vw,1.5rem)] text-neutral-500">
        /{totalCount}
      </span>
    </p>
    <h3 id={`content-title-${index}`} class="sr-only">{item.name}</h3>
    <img
      class="block max-h-[clamp(56px,6vw,96px)] w-[min(100%,520px)] object-contain object-left"
      src={item.titleSvg.src}
      alt=""
      loading="lazy"
      decoding="async"
      aria-hidden="true"
    />
    <p class="mt-3 text-[clamp(0.875rem,1.2vw,1.25rem)] font-extrabold">
      {item.englishName}
    </p>
  </header>

  <div class="ml-[clamp(0px,5vw,140px)] mt-[clamp(40px,5vw,72px)]">
    <div
      class="grid items-start gap-[clamp(24px,4vw,64px)] lg:grid-cols-[minmax(0,1fr)_minmax(280px,360px)] lg:pl-[clamp(72px,14vw,240px)]"
    >
      <div class="min-w-0 pt-1">
        <p
          class="m-0 text-[clamp(1.25rem,1.7vw,1.75rem)] leading-[1.55] font-extrabold"
        >
          {item.headline}
        </p>
        <p
          class="mt-6 text-[clamp(0.875rem,1vw,1rem)] leading-[1.85] font-medium tracking-[0.04em]"
        >
          {item.body}
        </p>
      </div>

      <dl class="m-0 border-y border-[#1a1a18] py-4">
        {
          item.details.map((detail) => (
            <div class="grid grid-cols-[5.5em_1fr] gap-4 py-1.5 text-[clamp(0.8125rem,0.9vw,0.9375rem)] leading-[1.7]">
              <dt class="font-extrabold">{detail.label}</dt>
              <dd class="m-0 font-medium">{detail.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="mx-auto mt-[clamp(48px,6vw,88px)] w-[min(100%,1120px)]">
      <img
        class="block aspect-[1.55/1] w-full object-cover"
        src={item.image.src}
        alt={item.name}
        loading="lazy"
        decoding="async"
      />
      <figcaption class="sr-only">{item.caption}</figcaption>
    </figure>

    {
      item.galleryImages && item.galleryImages.length > 0 && (
        <div
          class:list={[
            "mt-[clamp(48px,6vw,88px)] grid gap-[clamp(24px,3vw,48px)]",
            gallery.wrap,
          ]}
          aria-label={`${item.name}の写真`}
        >
          {item.galleryImages.map((galleryImage, galleryIndex) => (
            <figure
              class:list={[
                "m-0",
                gallery.items[galleryIndex] ?? "md:col-span-4",
              ]}
            >
              <img
                class:list={[
                  "block w-full object-cover",
                  galleryIndex === 0
                    ? "aspect-[1.45/1]"
                    : galleryIndex === 3
                      ? "aspect-[0.85/1]"
                      : "aspect-[1.28/1]",
                ]}
                src={galleryImage.image.src}
                alt={galleryImage.alt ?? item.name}
                loading="lazy"
                decoding="async"
              />
              {galleryImage.caption && (
                <figcaption class="mt-2.5 text-[0.6875rem] leading-[1.6] text-[#4a4a45]">
                  {galleryImage.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      )
    }

    {index < total - 1 && <div class="mt-[clamp(56px,8vw,112px)]" />}
  </div>
</article>
