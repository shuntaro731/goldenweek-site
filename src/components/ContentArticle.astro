---
import type { Museum } from "../data/museums";

interface Props {
  item: Museum;
  index: number;
  total: number;
}

const { item, index, total } = Astro.props as Props;
const number = String(index + 1).padStart(2, "0");

// 各ギャラリーのカラムズcss
const galleryLayouts = {
  split: {
    wrap: "md:grid-cols-12 md:items-start",
    items: [
      "md:col-span-5 md:col-start-2",
      "md:col-span-5 md:col-start-7 md:mt-24",
      "md:col-span-4 md:col-start-1 md:mt-8",
      "md:col-span-4 md:col-start-6 md:mt-20",
      "md:col-span-3 md:col-start-10 md:mt-2",
    ],
  },
  staggered: {
    wrap: "md:grid-cols-12 md:items-start",
    items: [
      "md:col-span-7 md:col-start-1",
      "md:col-span-4 md:col-start-9 md:mt-32",
      "md:col-span-5 md:col-start-3 md:mt-14",
      "md:col-span-4 md:col-start-8 md:mt-4",
      "md:col-span-6 md:col-start-1 md:mt-24",
    ],
  },
  mosaic: {
    wrap: "md:grid-cols-12 md:items-end",
    items: [
      "md:col-span-8 md:col-start-3",
      "md:col-span-3 md:col-start-1 md:mt-18",
      "md:col-span-4 md:col-start-5 md:mt-28",
      "md:col-span-3 md:col-start-10 md:mt-12",
      "md:col-span-7 md:col-start-4 md:mt-20",
    ],
  },
};

const gallery = galleryLayouts[item.galleryLayout];
---

<!-- タイトル -->
<article aria-labelledby={`content-title-${index}`} class="mt-20">
  <header>
    <h3 id={`content-title-${index}`} class="sr-only">{item.name}</h3>
    <img
      class="h-16 w-auto max-w-full object-contain object-left"
      src={item.titleSvg.src}
      alt=""
      loading="lazy"
      decoding="async"
      aria-hidden="true"
    />
    <p class="mt-5 text-xl font-normal">
      {item.englishName}
    </p>
  </header>

  <div class="mt-32 md:ml-35">
    <div
      class="mx-auto grid w-full max-w-6xl items-start gap-y-12 gap-x-17 lg:grid-cols-[minmax(0,1fr)_360px]"
    >
      <!-- 見出し2タイトル -->
      <h2
        class="whitespace-pre-line text-3xl leading-[1.55] font-bold lg:col-start-1 lg:row-start-1"
      >
        {item.headline}
      </h2>
      <!-- 本文 -->
      <p
        class="whitespace-pre-line text-base leading-[1.85] font-medium tracking-[0.04em] lg:col-start-1 lg:row-start-2"
      >
        {item.body}
      </p>

      <!-- 補足 -->
      <dl class="mt-4 border-y border-[#1a1a18] py-4 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-0">
        {
          item.details.map((detail) => (
            <div class="grid grid-cols-[5.5em_1fr] gap-4 py-1.5 text-sm leading-[1.7]">
              <dt class="font-bold">{detail.label}</dt>
              <dd class="whitespace-pre-line font-medium">{detail.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- 画像 -->
    <figure class="mx-auto mt-24 w-full max-w-6xl">
      <img
        class="aspect-[1.55/1] w-full object-cover"
        src={item.image.src}
        alt={item.name}
        loading="lazy"
        decoding="async"
      />
      <figcaption class="sr-only">{item.caption}</figcaption>
    </figure>

    <!-- ギャラリー画像 -->
    {
      item.galleryImages && item.galleryImages.length > 0 && (
        <div
          class:list={[
            "mt-24 grid gap-12",
            gallery.wrap,
          ]}
          aria-label={`${item.name}の写真`}
        >
          {item.galleryImages.map((galleryImage, galleryIndex) => (
            <figure
              class:list={[
                "overflow-hidden",
                gallery.items[galleryIndex] ?? "md:col-span-4",
              ]}
            >
              <img
                class:list={[
                  "parallax-image w-full object-cover",
                  galleryIndex === 0
                    ? "aspect-[1.45/1]"
                    : galleryIndex === 3
                      ? "aspect-[0.85/1]"
                      : "aspect-[1.28/1]",
                ]}
                src={galleryImage.image.src}
                alt={galleryImage.alt ?? item.name}
                loading="lazy"
                decoding="async"
                data-parallax-image
              />
              {galleryImage.caption && (
                <figcaption class="mt-2.5 text-[0.6875rem] leading-[1.6] text-[#4a4a45]">
                  {galleryImage.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      )
    }

    {index < total - 1 && <div class="mt-28" />}
  </div>
</article>
