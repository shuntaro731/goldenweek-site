---
import logo from "../assets/logo.svg";

const footerNavItems = [
  { label: "About", href: "#introduction" },
  { label: "Museum List", href: "#contents" },
  { label: "Top", href: "/" },
];
---

<footer class="mt-40 bg-neutral-600 text-[#f3f2e8]" aria-labelledby="footer-logo">
  <div
    class="mx-auto grid w-[min(100%,1440px)] gap-16 px-[clamp(32px,7vw,112px)] py-[clamp(56px,7vw,96px)]"
  >
    <div
      class="grid gap-16 md:grid-cols-[minmax(180px,1fr)_minmax(360px,1.35fr)]"
    >
      <nav aria-label="フッターナビゲーション">
        <ul
          class="grid gap-5 text-[clamp(1.125rem,1.6vw,1.5rem)] leading-none font-medium"
        >
          {
            footerNavItems.map((item) => (
              <li>
                <a
                  class="inline-block text-[#f3f2e8] no-underline transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f3f2e8]"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="md:justify-self-end md:text-right">
        <a class="inline-block" href="/" aria-label="トップページへ">
          <img
            id="footer-logo"
            class="footer-logo w-[min(52vw,280px)] md:w-[min(24vw,360px)]"
            src={logo.src}
            alt="このゴールデンウィークは 日本の美術館へ"
          />
        </a>
      </div>
    </div>

    <p class="text-sm font-medium tracking-wide text-[#f3f2e8]/80">
      © 2026 Museum Guide. All Rights Reserved.
    </p>
  </div>
</footer>

<style>
  .footer-logo {
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }
</style>
