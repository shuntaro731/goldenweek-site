---
import ContentArticle from "./ContentArticle.astro";
import type { Museum } from "../../data/museums";

interface Props {
  items: Museum[];
}

const { items } = Astro.props;
---

<section class="contents-section bg-[#f4f4ef]" aria-labelledby="contents-title">
  <div class="contents-inner">
    <div class="contents-heading">
      <p class="contents-kicker">Museum Contents</p>
      <h2 id="contents-title">行ってみたい美術館</h2>
    </div>

    <div class="contents-list">
      {
        items.map((item, index) => (
          <ContentArticle item={item} index={index} variant={index % 3} />
        ))
      }
    </div>
  </div>
</section>

<style>
  .contents-section {
    color: #1a1a18;
    padding: clamp(88px, 11vw, 176px) 0 clamp(96px, 12vw, 192px);
  }

  .contents-inner {
    width: min(100%, 1440px);
    margin: 0 auto;
  }

  .contents-heading {
    margin: 0 clamp(24px, 7vw, 112px) clamp(72px, 8vw, 128px);
    border-top: 1px solid currentColor;
    padding-top: clamp(24px, 3vw, 44px);
  }

  .contents-kicker {
    margin: 0 0 14px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .contents-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 5.5rem);
    font-weight: 800;
    line-height: 0.95;
  }

  .contents-list {
    display: grid;
    gap: clamp(88px, 11vw, 176px);
  }
</style>
