---
import type { Museum } from "../../data/museums";

interface Props {
  item: Museum;
  index: number;
  variant: number;
}

const { item, index, variant } = Astro.props;
const number = String(index + 1).padStart(2, "0");
---

<article
  class:list={["content-article", `content-article--variant-${variant}`]}
  aria-labelledby={`content-title-${index}`}
>
  <header class="content-title-block">
    <p class="content-number">{number}</p>
    <h2 id={`content-title-${index}`} class="sr-only">{item.name}</h2>
    <img
      class="content-title-image"
      src={item.titleSvg.src}
      alt=""
      loading="lazy"
      decoding="async"
      aria-hidden="true"
    />
    <p class="content-english-name">{item.englishName}</p>
  </header>

  <figure class="content-main-figure">
    <img
      class="content-main-image"
      src={item.image.src}
      alt={item.name}
      loading="lazy"
      decoding="async"
    />
    <figcaption>{item.caption}</figcaption>
  </figure>

  <div class="content-copy">
    <p class="content-copy-label">Museum Story</p>
    <p>{item.description}</p>
  </div>

  {
    item.galleryImages && item.galleryImages.length > 0 && (
      <div class="content-gallery" aria-label={`${item.name}の写真`}>
        {item.galleryImages.map((galleryImage) => (
          <figure>
            <img
              src={galleryImage.image.src}
              alt={galleryImage.alt ?? item.name}
              loading="lazy"
              decoding="async"
            />
            {galleryImage.caption && (
              <figcaption>{galleryImage.caption}</figcaption>
            )}
          </figure>
        ))}
      </div>
    )
  }
</article>

<style>
  .content-article {
    display: grid;
    grid-template-columns:
      minmax(24px, 0.45fr)
      minmax(0, 6fr)
      minmax(0, 5fr)
      minmax(24px, 0.45fr);
    grid-template-areas:
      ". title title ."
      ". media copy ."
      ". gallery gallery .";
    column-gap: clamp(32px, 6vw, 96px);
    row-gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }

  .content-title-block {
    grid-area: title;
    border-top: 1px solid currentColor;
    padding-top: clamp(22px, 3vw, 40px);
  }

  .content-number {
    margin: 0 0 clamp(18px, 2.6vw, 36px);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .content-title-image {
    display: block;
    width: min(100%, 620px);
    max-height: clamp(78px, 10vw, 154px);
    object-fit: contain;
    object-position: left center;
  }

  .content-english-name {
    margin: clamp(18px, 2vw, 28px) 0 0;
    font-size: clamp(0.8rem, 1vw, 1rem);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .content-main-figure {
    grid-area: media;
    margin: 0;
  }

  .content-main-image {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1.06;
    object-fit: cover;
  }

  .content-main-figure figcaption,
  .content-gallery figcaption {
    margin-top: 10px;
    color: #4a4a45;
    font-size: 0.6875rem;
    line-height: 1.6;
  }

  .content-copy {
    grid-area: copy;
    max-width: 520px;
    padding-top: clamp(8px, 2vw, 28px);
  }

  .content-copy-label {
    margin: 0 0 clamp(22px, 3vw, 44px);
    border-bottom: 1px solid currentColor;
    padding-bottom: 12px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .content-copy > p:not(.content-copy-label) {
    margin: 0;
    font-size: clamp(0.875rem, 1.1vw, 1rem);
    font-weight: 500;
    line-height: 2.15;
    letter-spacing: 0.04em;
  }

  .content-gallery {
    grid-area: gallery;
    display: grid;
    grid-template-columns: 1fr 1.45fr 0.8fr;
    gap: clamp(18px, 2.5vw, 32px);
    margin-top: clamp(16px, 4vw, 64px);
  }

  .content-gallery figure {
    margin: 0;
  }

  .content-gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 1.28 / 1;
    object-fit: cover;
  }

  .content-article--variant-1 {
    grid-template-columns:
      minmax(24px, 0.45fr)
      minmax(0, 5fr)
      minmax(0, 6fr)
      minmax(24px, 0.45fr);
    grid-template-areas:
      ". title media ."
      ". copy media ."
      ". gallery gallery .";
  }

  .content-article--variant-1 .content-title-block {
    align-self: end;
    border-top: 0;
    padding-top: clamp(32px, 6vw, 88px);
  }

  .content-article--variant-1 .content-main-image {
    aspect-ratio: 1.15 / 1;
  }

  .content-article--variant-1 .content-copy {
    padding-top: clamp(24px, 5vw, 80px);
  }

  .content-article--variant-1 .content-title-image {
    width: min(100%, 560px);
  }

  .content-article--variant-2 {
    grid-template-columns:
      minmax(24px, 0.45fr)
      minmax(0, 4fr)
      minmax(0, 7fr)
      minmax(24px, 0.45fr);
    grid-template-areas:
      ". title title ."
      ". copy media ."
      ". gallery gallery .";
  }

  .content-article--variant-2 .content-title-block {
    width: min(100%, 880px);
    margin-left: auto;
  }

  .content-article--variant-2 .content-title-image {
    width: min(100%, 520px);
    margin-left: auto;
    object-position: right center;
  }

  .content-article--variant-2 .content-number,
  .content-article--variant-2 .content-english-name {
    text-align: right;
  }

  .content-article--variant-2 .content-main-image {
    aspect-ratio: 1.72 / 1;
  }

  .content-article--variant-2 .content-copy {
    padding-top: clamp(42px, 8vw, 132px);
  }

  @media (max-width: 860px) {
    .content-article,
    .content-article--variant-1,
    .content-article--variant-2 {
      grid-template-columns: minmax(20px, 1fr) minmax(0, 11fr) minmax(20px, 1fr);
      grid-template-areas:
        ". title ."
        ". media ."
        ". copy ."
        ". gallery .";
      row-gap: 28px;
    }

    .content-article--variant-1 .content-title-block,
    .content-article--variant-2 .content-title-block {
      width: auto;
      margin-left: 0;
      border-top: 1px solid currentColor;
      padding-top: 24px;
    }

    .content-title-image,
    .content-article--variant-1 .content-title-image,
    .content-article--variant-2 .content-title-image {
      width: min(100%, 440px);
      max-height: 96px;
      margin-left: 0;
      object-position: left center;
    }

    .content-article--variant-2 .content-number,
    .content-article--variant-2 .content-english-name {
      text-align: left;
    }

    .content-copy,
    .content-article--variant-1 .content-copy,
    .content-article--variant-2 .content-copy {
      max-width: none;
      padding-top: 0;
    }

    .content-main-image,
    .content-article--variant-1 .content-main-image,
    .content-article--variant-2 .content-main-image {
      aspect-ratio: 1.24 / 1;
    }

    .content-gallery {
      grid-template-columns: 1fr;
      margin-top: 8px;
    }
  }
</style>
