---
import Header from "../components/Header.astro";
import "../styles/global.css";
---

<!-- どのファイル内でも共通している要素を置く -->
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>このゴールデンウィークは日本の美術館へ</title>
  </head>
  <body>
    <Header />
    <main class="index-background flex min-h-0 flex-1 flex-col">
      <slot />
    </main>
  </body>
</html>

<script>
  const parallaxImages = document.querySelectorAll<HTMLImageElement>(
    "[data-parallax-image]",
  );
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let frameId: number | null = null;

  const updateParallax = () => {
    frameId = null;

    if (reduceMotion.matches) return;

    parallaxImages.forEach((image) => {
      const frame = image.parentElement;
      if (!frame) return;

      const rect = frame.getBoundingClientRect();
      const viewportCenter = window.innerHeight / 2;
      const frameCenter = rect.top + rect.height / 2;
      const progress = (frameCenter - viewportCenter) / window.innerHeight;
      const offset = Math.max(-1, Math.min(1, progress)) * -15;

      image.style.transform = `translate3d(0, ${offset}%, 0) scale(1.1)`;
    });
  };

  const requestParallaxUpdate = () => {
    if (frameId !== null) return;
    frameId = window.requestAnimationFrame(updateParallax);
  };

  window.addEventListener("scroll", requestParallaxUpdate, { passive: true });
  window.addEventListener("resize", requestParallaxUpdate);
  updateParallax();
</script>

<style>
  html {
    margin: 0;
    width: 100%;
    height: 100%;
    min-height: 100svh;
    /* テキストの上下余白をカット */
    leading-trim: both;
    text-edge: cap alphabetic;
  }

  body {
    margin: 0;
    width: 100%;
    height: 100svh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    leading-trim: both;
    text-edge: cap alphabetic;
  }
</style>
