---
import Header from "../components/Header.astro";
import "../styles/global.css";
---

<!-- どのファイル内でも共通している要素を置く -->
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>このゴールデンウィークは日本の美術館へ</title>
  </head>
  <body>
    <Header />
    <main class="index-background flex min-h-0 flex-1 flex-col">
      <slot />
    </main>
  </body>
</html>

<style>
  html {
    margin: 0;
    width: 100%;
    height: 100%;
    min-height: 100svh;
    /* テキストの上下余白をカット */
    leading-trim: both;
    text-edge: cap alphabetic;
  }

  body {
    margin: 0;
    width: 100%;
    height: 100svh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    leading-trim: both;
    text-edge: cap alphabetic;
  }
</style>
