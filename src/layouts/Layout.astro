---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
---

<!-- どのファイル内でも共通している要素を置く -->
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>このゴールデンウィークは日本の美術館へ</title>
  </head>
  <body>
    <Header />
    <main class="index-background flex min-h-0 flex-1 flex-col">
      <slot />
    </main>
    <Footer />
  </body>
</html>


<style>
  html {
    margin: 0;
    width: 100%;
    min-height: 100svh;
    /* テキストの上下余白をカット */
    leading-trim: both;
    text-edge: cap alphabetic;
  }
  
  body {
    margin: 0;
    width: 100%;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    leading-trim: both;
    text-edge: cap alphabetic;
  }
</style>

<!-- パララックスアニメーション : スクロール時に transform を更新 -->
<script>
  const parallaxImages = [
    ...document.querySelectorAll<HTMLImageElement>("[data-parallax-image]"),
  ];
  const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  let ticking = false;

  const updateParallaxImages = () => {
    ticking = false;

    if (reducedMotionQuery.matches) {
      parallaxImages.forEach((image) => {
        image.style.transform = "translate3d(0, 0, 0) scale(1.1)";
      });
      return;
    }

    const viewportHeight = window.innerHeight;

    parallaxImages.forEach((image) => {
      const rect = image.getBoundingClientRect();
      const progress =
        (viewportHeight - rect.top) / (viewportHeight + rect.height);
      const clampedProgress = Math.min(Math.max(progress, 0), 1);
      // 
      const offset = (clampedProgress - 0.5) * 26;

      image.style.transform = `translate3d(0, ${offset}%, 0) scale(1.1)`;
    });
  };

  const requestParallaxUpdate = () => {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(updateParallaxImages);
  };

  if (parallaxImages.length > 0) {
    updateParallaxImages();
    window.addEventListener("scroll", requestParallaxUpdate, { passive: true });
    window.addEventListener("resize", requestParallaxUpdate);
    reducedMotionQuery.addEventListener("change", requestParallaxUpdate);
  }
</script>
